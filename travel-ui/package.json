{
  "name": "travel-ui",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@4.2.2",
  "author": "Microarchitecturovisco",
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@fontsource/roboto": "^5.0.12",
    "@mui/icons-material": "^5.15.15",
    "@mui/material": "^5.15.15",
    "@mui/x-date-pickers": "^7.5.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.6",
    "@types/react": "^18.2.75",
    "@types/react-dom": "^18.2.24",
    "axios": "^1.6.8",
    "dayjs": "^1.11.11",
    "react": "^18.2.0",
    "react-countdown": "^2.3.5",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "react-scripts": "5.0.1",
    "typescript": "^5.4.4",
    "uuid": "^9.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test --roots tests/unit --testMatch \"<rootDir>/tests/unit/**/*.{spec,test}.{js,jsx,ts,tsx}\" --watchAll=false",
    "test:unit": "react-scripts test --roots tests/unit --testMatch \"<rootDir>/tests/unit/**/*.{spec,test}.{js,jsx,ts,tsx}\" --watchAll=false",
    "test:unit:coverage": "react-scripts test --roots tests/unit --testMatch \"<rootDir>/tests/unit/**/*.{spec,test}.{js,jsx,ts,tsx}\" --watchAll=false --runInBand --coverage",
    "test:coverage": "yarn test:unit:coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test",
    "test:e2e:report": "playwright show-report",
    "eject": "react-scripts eject",
    "serve": "serve -s build -l 53000"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/uuid": "^9",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.3"
  },
  "jest": {
    "coverageThreshold": {
      "global": {
        "statements": 58,
        "branches": 35
      }
    }
  }
}
