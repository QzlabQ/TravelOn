# OpenAI-compatible model endpoint. Replace these values with your provider's settings.
AI_BASE_URL=https://your-provider.example.com/v1
AI_CHAT_COMPLETIONS_PATH=/chat/completions
AI_API_KEY=
AI_MODEL=your-model-name
AI_THINKING_TYPE=omit
AI_JSON_MODE=true
AI_TEMPERATURE=0.6
AI_MAX_TOKENS=12000
AI_MODEL_TIMEOUT_SECONDS=90
AI_SLOW_RESPONSE_WARNING_MS=60000

# Planner Agent runtime settings.
AGENT_MODEL_TIMEOUT_SECONDS=90
AGENT_MAX_RUNTIME_SECONDS=120
AI_RETRY_COUNT=1
AI_RETRY_BACKOFF_SECONDS=1
