FROM maven:3.9.9-eclipse-temurin-21 AS build
ENV HOME=/usr/app
RUN mkdir -p $HOME
WORKDIR $HOME
COPY travel-api/user-service/ ./user-service/
WORKDIR $HOME/user-service
RUN --mount=type=cache,target=/root/.m2 sh -c 'for i in 1 2 3; do mvn -B -ntp clean package -Dmaven.test.skip -Dmaven.wagon.http.retryHandler.count=5 && exit 0; echo "Maven retry $i"; sleep 5; done; exit 1'

FROM eclipse-temurin:21-jre
COPY --from=build /usr/app/user-service/target/*.jar /app/runner.jar
COPY travel-api/seed-data/common /seed-data/common
ENTRYPOINT ["java", "-jar", "/app/runner.jar"]
