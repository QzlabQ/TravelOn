#!/usr/bin/env bash
set -euo pipefail
tag="${1:-}"
[[ "$tag" =~ ^sha-[0-9a-f]{7,40}$ ]] || exit 2
[[ "${SUDO_USER:-}" == travelon-runner ]] || exit 3
workspace="$(pwd -P)"
case "$workspace" in /home/travelon-runner/_work/*/*|/home/travelon-runner/actions-runner/_work/*/*) ;; *) exit 4 ;; esac
[[ "$(stat -c %U "$workspace")" == travelon-runner ]] || exit 5
rendered="$(mktemp /tmp/travelon-k8s.XXXXXX.yaml)"; trap 'rm -f "$rendered"' EXIT
k3s kubectl kustomize k8s/base >"$rendered"
sed -Ei "s#(image: travelon-[a-z0-9-]+):latest#\1:${tag}#" "$rendered"
sed -Ei "s#image: ghcr.io/qzlabq/(travelon-[a-z0-9-]+):latest#image: \1:${tag}#" "$rendered"
if grep -Eq 'image: ghcr.io/qzlabq/travelon-|image: travelon-[a-z0-9-]+:latest' "$rendered"; then
  echo 'Kubernetes image is not covered by ops/cd/images.tsv' >&2
  exit 8
fi
if grep -Eq '^[[:space:]]*(privileged:[[:space:]]*true|hostPath:|hostNetwork:[[:space:]]*true|hostPID:[[:space:]]*true|hostIPC:[[:space:]]*true)' "$rendered"; then exit 6; fi
k3s kubectl get namespace travelon >/dev/null
k3s kubectl -n travelon get secret travelon-secrets >/dev/null
k3s kubectl label namespace travelon pod-security.kubernetes.io/enforce=baseline --overwrite
k3s kubectl apply -f "$rendered"

# Only wait for resources declared by this revision.  Namespace-wide discovery
# would keep retired services alive and make a new deployment wait on them.
desired_workload_count=0
while IFS= read -r resource; do
  ((desired_workload_count += 1))
  case "$resource" in
    statefulset/*) timeout=25m ;;
    deployment/*) timeout=15m ;;
    *) exit 6 ;;
  esac
  k3s kubectl -n travelon rollout status "$resource" --timeout="$timeout"
done < <(
  awk '
    /^kind: StatefulSet$/ { kind = "statefulset"; next }
    /^kind: Deployment$/ { kind = "deployment"; next }
    /^metadata:$/ { read_metadata = (kind != ""); next }
    read_metadata && /^  name: / {
      print kind "/" $2
      kind = ""
      read_metadata = 0
    }
  ' "$rendered"
)
(( desired_workload_count > 0 )) || { echo 'no workloads rendered' >&2; exit 6; }

# Deployment rollout 只保证 Pod 就绪；Eureka 客户端仍可能短暂缓存已退出 Pod。
# 冒烟检查使用有上限的重试，关键 Gateway 链路还要求连续成功三次，避免把
# 服务发现尚未收敛时的一次偶然成功当成部署完成。
run_smoke_check() {
  local name="$1"
  local url="$2"
  local required_successes="${3:-1}"
  local max_attempts=36
  local retry_delay_seconds=5
  local command_timeout_seconds=10
  local attempt consecutive_successes=0

  for ((attempt = 1; attempt <= max_attempts; attempt++)); do
    if timeout "${command_timeout_seconds}s" k3s kubectl -n travelon exec deployment/travelon-ui -- wget -qO- "$url" >/dev/null; then
      ((consecutive_successes += 1))
      if ((consecutive_successes >= required_successes)); then
        echo "smoke check passed: $name ($consecutive_successes consecutive successes)"
        return 0
      fi
    else
      consecutive_successes=0
    fi

    if ((attempt < max_attempts)); then
      echo "smoke check waiting: $name (attempt $attempt/$max_attempts, consecutive $consecutive_successes/$required_successes)" >&2
      sleep "$retry_delay_seconds"
    fi
  done

  echo "smoke check failed: $name after $max_attempts attempts" >&2
  return 1
}

run_smoke_check discovery http://discovery:8010/
run_smoke_check ai-arrange-agent http://ai-arrange-agent:8090/agent/health
run_smoke_check gateway-hotels http://gateway:8082/hotels/destinations 3

# Resource retirement is declarative and intentionally runs only after the
# replacement workloads pass rollout and smoke tests.  Its schema is narrow so
# it cannot delete Secrets, PVCs, namespaces, or arbitrary Kubernetes kinds.
retired_resources="$workspace/ops/cd/retired-resources.tsv"
if [[ -r "$retired_resources" ]]; then
  while IFS=$'\t' read -r api_version kind name; do
    [[ -z "$api_version" || "$api_version" == \#* ]] && continue
    [[ "$name" =~ ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$ ]] || {
      echo "invalid retired resource name: $name" >&2
      exit 7
    }
    case "$api_version:$kind" in
      apps/v1:Deployment|v1:Service|networking.k8s.io/v1:Ingress) ;;
      *) echo "invalid retired resource: $api_version $kind" >&2; exit 7 ;;
    esac
    k3s kubectl -n travelon delete --ignore-not-found "$kind/$name"
  done < "$retired_resources"
fi

# All resources rendered from this revision carry this label.  Future removal
# of a managed workload is therefore reconciled automatically, without broad
# namespace pruning and without selecting Secrets or persistent volumes.
k3s kubectl -n travelon apply --prune -l app.kubernetes.io/managed-by=travelon-cd \
  --prune-allowlist=apps/v1/Deployment \
  --prune-allowlist=apps/v1/StatefulSet \
  --prune-allowlist=core/v1/Service \
  --prune-allowlist=core/v1/ConfigMap \
  --prune-allowlist=networking.k8s.io/v1/Ingress \
  --prune-allowlist=autoscaling/v2/HorizontalPodAutoscaler \
  --prune-allowlist=policy/v1/PodDisruptionBudget \
  -f "$rendered"
k3s kubectl -n travelon get pods
